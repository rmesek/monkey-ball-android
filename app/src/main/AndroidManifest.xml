<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonkeyBall">

        <!-- The game. No configuration change recreates the activity: the engine runs once per process
             (see native/src/lib.rs), and onDestroy ends it. Rotation and resizing reach the Rust side as a
             new surface size; language, font size and the like do not concern the game at all. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender|assetsPaths"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- libmonkeyball.so, built from native/ -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="monkeyball" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long press on the icon: "Play with metrics" (Metrics.kt). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- The app's long-press shortcut: the game with frame statistics on screen (Metrics.kt). The extra is read
     as a boolean. targetPackage is the applicationId (app/build.gradle.kts). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="metrics"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/metrics_shortcut_short"
        android:shortcutLongLabel="@string/metrics_shortcut_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.github.rmesek.monkeyball"
            android:targetClass="io.github.rmesek.monkeyball.MainActivity">
            <extra
                android:name="metrics"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
